# --- Database (host port 5433: avoids clash with system PostgreSQL on 5432) ---
DATABASE_URL=postgresql+psycopg://zellovest:zellovest@localhost:5433/zellovest
ASYNC_DATABASE_URL=postgresql+asyncpg://zellovest:zellovest@localhost:5433/zellovest

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_QUEUE=integration_tasks

# --- Ramp OAuth ---
RAMP_CLIENT_ID=your-ramp-client-id
RAMP_CLIENT_SECRET=your-ramp-client-secret
RAMP_AUTH_URL=https://app.ramp.com/v1/authorize
RAMP_TOKEN_URL=https://api.ramp.com/developer/v1/token
RAMP_API_BASE_URL=https://api.ramp.com/developer/v1
RAMP_REDIRECT_URI=http://localhost:8000/api/v1/integrations/ramp/callback
RAMP_WEBHOOK_SECRET=your-ramp-webhook-secret
RAMP_WEBHOOK_SIGNATURE_HEADER=X-Ramp-Signature

# --- Google Drive OAuth / ingestion (mirrors Ramp groups) ---
GOOGLE_DRIVE_CLIENT_ID=your-google-client-id
GOOGLE_DRIVE_CLIENT_SECRET=your-google-client-secret
GOOGLE_DRIVE_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_DRIVE_TOKEN_URL=https://oauth2.googleapis.com/token
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/google-drive/callback
GOOGLE_DRIVE_WEBHOOK_TOKEN=your-drive-channel-token
GOOGLE_DRIVE_WEBHOOK_CALLBACK_URL=https://your-public-host/api/v1/webhooks/google-drive

# --- Okta OAuth (per-tenant Connect button, mirrors Ramp groups) ---
# OKTA_DOMAIN is the org domain; authorize/token endpoints are derived as
# https://{OKTA_DOMAIN}/oauth2/v1/{authorize,token} (org authorization
# server — the only issuer that mints okta.* API scopes). Register
# OKTA_REDIRECT_URI as the sign-in redirect URI on the Okta OIDC app
# (Authorization Code + Refresh Token grants).
OKTA_DOMAIN=your-org.okta.com
OKTA_CLIENT_ID=your-okta-client-id
OKTA_CLIENT_SECRET=your-okta-client-secret
OKTA_REDIRECT_URI=http://localhost:8000/api/v1/integrations/okta/callback

# --- Token encryption (base64 of 32 random bytes; generate with: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())") ---
CREDENTIALS_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTES==

# --- OAuth state ---
OAUTH_STATE_TTL_SECONDS=600

# --- GCS raw bucket (bronze lake, GCP-only) ---
GCS_RAW_BUCKET=tenant-bucket
GCS_ML_BUCKET=tenant-ml-bucket
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# Host-side path used by processes started directly on the host.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# Docker Compose mounts this host file read-only at /run/secrets/gcp-sa.json
# and points GOOGLE_APPLICATION_CREDENTIALS there inside the containers.
# On Windows use forward slashes, e.g. C:/Users/me/keys/service-account.json.
GOOGLE_APPLICATION_CREDENTIALS_HOST=./secrets/service-account.json
BIGQUERY_BRONZE_DATASET=zellovest_bronze
BIGQUERY_SILVER_DATASET=zellovest_silver
BIGQUERY_GOLD_DATASET=zellovest_gold
BIGQUERY_SEAT_FEATURES_TABLE=gold_seat_features
VERTEX_AI_REGION=us-central1
# Custom images built from the worker package for scheduled training and optional registry metadata.
VERTEX_TRAINING_IMAGE_URI=us-central1-docker.pkg.dev/your-project/zellovest-ml/seat-training:latest
VERTEX_MODEL_SERVING_IMAGE_URI=us-central1-docker.pkg.dev/your-project/zellovest-ml/seat-model:latest
SEAT_MODEL_CACHE_DIR=/tmp/models
SEAT_DEFAULT_TRUEUP_PENALTY_RATE=0.25
# Local dev: point workers at the GCS emulator (fake-gcs-server).
# STORAGE_EMULATOR_HOST=http://localhost:4443



# --- Ingestion tuning ---
POLL_BATCH_SIZE=100
RATE_LIMIT_RPS=5.0
API_V1_PREFIX=/api/v1
ENVIRONMENT=local

# --- RAG indexing and retrieval ---
# Docker Compose overrides this to http://qdrant:6333 for app containers.
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=zellovest_documents
QDRANT_API_KEY=
VOYAGE_API_KEY=REPLACE_WITH_VOYAGE_API_KEY
VOYAGE_MODEL=voyage-3-large
VOYAGE_API_URL=https://api.voyageai.com/v1/embeddings

# --- RAG answer generation and evaluation ---
GROQ_API_KEY=REPLACE_WITH_GROQ_API_KEY
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=90

# --- MCP layer (MCP-1 Procurement, MCP-2 Documents, MCP-3 External) ---
# Shared bearer token between the Agentic Reasoning host and all MCP servers.
# Must be identical everywhere; override per deployment and never commit it.
MCP_SERVICE_TOKEN=REPLACE_WITH_LONG_RANDOM_MCP_TOKEN
# HMAC secret for high-risk action confirmations. Empty falls back to
# MCP_SERVICE_TOKEN (fine for local dev; set a distinct value in production).
MCP_CONFIRMATION_SECRET=
# Used when the host runs directly on the host machine. Docker Compose
# overrides these with the service names (http://mcp-procurement:8101/mcp).
MCP_PROCUREMENT_URL=http://localhost:8101/mcp
MCP_DOCUMENT_URL=http://localhost:8102/mcp
MCP_EXTERNAL_URL=http://localhost:8103/mcp
MCP_CONNECT_TIMEOUT_SECONDS=10
MCP_TRANSPORT_GRACE_SECONDS=5
MCP_MAX_RETRIES=2
MCP_RETRY_BACKOFF_SECONDS=0.25
MCP_CIRCUIT_FAILURE_THRESHOLD=3
MCP_CIRCUIT_RESET_SECONDS=30
MCP_DEFAULT_ACTOR_ROLE=procurement_member
# MCP server boundaries (headers carry tenant/actor; these are fallbacks only).
MCP_ALLOW_ANONYMOUS=false
MCP_DEFAULT_TENANT=default-org
MCP_DEFAULT_ROLE=procurement_member
MCP_AUDIT_DB_ENABLED=true

# --- Ask AI agent guardrails ---
AGENT_MAX_PLAN_STEPS=6
AGENT_MAX_TOOL_CALLS=8
AGENT_HISTORY_TURNS=6
AGENT_EVIDENCE_CHARS=6000
AGENT_CONVERSATION_PERSISTENCE=true
ASK_AI_CONFIRMATION_TTL_SECONDS=900

# --- MCP-3 external systems (optional; tools return unavailable when unset) ---
ERP_BASE_URL=
ERP_API_TOKEN=
ERP_TIMEOUT_SECONDS=15
SLACK_BOT_TOKEN=
SLACK_SEARCH_TOKEN=
SLACK_DEFAULT_CHANNEL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_USE_TLS=true

# --- Langfuse Cloud (metadata-only traces; never log prompt/document text) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
RAG_EVALUATOR_MODEL=

# --- Service JWT (all FastAPI services) ---
JWT_SECRET_KEY=REPLACE_WITH_LONG_RANDOM_STRING
JWT_ALGORITHM=HS256
# Access token lifetime (minutes). Clients silently refresh before expiry.
JWT_EXPIRE_MINUTES=60
# Refresh token lifetime (days). Keeps users signed in without re-entering
# credentials; POST /api/v1/auth/refresh exchanges it for a fresh token pair.
JWT_REFRESH_EXPIRE_DAYS=7

# --- Local auth bootstrap (invite-only onboarding, no public signup) ---
# First member: seeded from the server shell AFTER `alembic upgrade head`:
#   FIRST_USER_EMAIL="you@company.com" FIRST_USER_PASSWORD="..." \
#       uv run python scripts/seed_user.py --name "Your Name"
# (CLI flags > env vars > interactive prompt; never commit real values —
# .env is gitignored. From then on, members join via invite links.)
#FIRST_USER_EMAIL=you@company.com
#FIRST_USER_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# Public demo account: frictionless sandbox entry needs NO password —
# POST /api/v1/auth/demo auto-creates it on first click. DEMO_EMAIL only
# selects the sandbox identity (adopted + flagged is_demo if it exists).
# The --demo seed flag is now optional (pre-seeding); the password it sets
# is a random secret nobody types.
#DEMO_EMAIL=demo@zellovest.ai

# Invite links expire after this many days (single-use regardless).
#INVITE_TOKEN_TTL_DAYS=7
