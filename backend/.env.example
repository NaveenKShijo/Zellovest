# --- Database (host port 5433: avoids clash with system PostgreSQL on 5432) ---
DATABASE_URL=postgresql+psycopg://zellovest:zellovest@localhost:5433/zellovest
ASYNC_DATABASE_URL=postgresql+asyncpg://zellovest:zellovest@localhost:5433/zellovest

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_QUEUE=integration_tasks

# --- Ramp OAuth ---
RAMP_CLIENT_ID=your-ramp-client-id
RAMP_CLIENT_SECRET=your-ramp-client-secret
RAMP_AUTH_URL=https://app.ramp.com/v1/authorize
RAMP_TOKEN_URL=https://api.ramp.com/developer/v1/token
RAMP_API_BASE_URL=https://api.ramp.com/developer/v1
RAMP_REDIRECT_URI=http://localhost:8000/api/v1/integrations/ramp/callback
RAMP_WEBHOOK_SECRET=your-ramp-webhook-secret
RAMP_WEBHOOK_SIGNATURE_HEADER=X-Ramp-Signature

# --- Google Drive OAuth / ingestion (mirrors Ramp groups) ---
GOOGLE_DRIVE_CLIENT_ID=your-google-client-id
GOOGLE_DRIVE_CLIENT_SECRET=your-google-client-secret
GOOGLE_DRIVE_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_DRIVE_TOKEN_URL=https://oauth2.googleapis.com/token
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/google-drive/callback
GOOGLE_DRIVE_WEBHOOK_TOKEN=your-drive-channel-token
GOOGLE_DRIVE_WEBHOOK_CALLBACK_URL=https://your-public-host/api/v1/webhooks/google-drive

# --- Okta OAuth (per-tenant Connect button, mirrors Ramp groups) ---
# OKTA_DOMAIN is the org domain; authorize/token endpoints are derived as
# https://{OKTA_DOMAIN}/oauth2/v1/{authorize,token} (org authorization
# server — the only issuer that mints okta.* API scopes). Register
# OKTA_REDIRECT_URI as the sign-in redirect URI on the Okta OIDC app
# (Authorization Code + Refresh Token grants).
OKTA_DOMAIN=your-org.okta.com
OKTA_CLIENT_ID=your-okta-client-id
OKTA_CLIENT_SECRET=your-okta-client-secret
OKTA_REDIRECT_URI=http://localhost:8000/api/v1/integrations/okta/callback

# --- Token encryption (base64 of 32 random bytes; generate with: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())") ---
CREDENTIALS_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTES==

# --- OAuth state ---
OAUTH_STATE_TTL_SECONDS=600

# --- S3 Bronze lake ---



# --- Ingestion tuning ---
POLL_BATCH_SIZE=100
RATE_LIMIT_RPS=5.0
API_V1_PREFIX=/api/v1
ENVIRONMENT=local

# --- Service JWT (all FastAPI services) ---
JWT_SECRET_KEY=REPLACE_WITH_LONG_RANDOM_STRING
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
