# Zellovest Frontend — Public Environment Configuration
# Copy to .env.local (development) or inject at build time (production).
# These values are safe to expose to the browser (NEXT_PUBLIC_*).

# ── Asgardeo (@asgardeo/nextjs SDK, "Big Regions" application) ─────────────
# Base URL of the Asgardeo organization (no trailing slash).
NEXT_PUBLIC_ASGARDEO_BASE_URL=https://api.asgardeo.io/t/zellovest

# Client ID of the Asgardeo application (public; safe for NEXT_PUBLIC_*).
NEXT_PUBLIC_ASGARDEO_CLIENT_ID=your-asgardeo-client-id

# Client secret — server-only (never use a NEXT_PUBLIC_ prefix).
ASGARDEO_CLIENT_SECRET=your-asgardeo-client-secret

# Session cookie signing secret — required in production.
# Generate with: openssl rand -base64 48
ASGARDEO_SECRET=your-random-session-secret

# OIDC scopes — exactly per the application spec.
NEXT_PUBLIC_ASGARDEO_SCOPES=openid profile

# Single-tenant organization display name (public branding).
#NEXT_PUBLIC_ORGANIZATION_NAME=Acme Technologies Inc.

# Redirect URLs — intentionally unset. The SDK then sends the raw request
# origin (http://localhost:3000) as redirect_uri, matching the Redirect
# URL registered on the Asgardeo application. Register that exact URL
# (Authorized redirect URLs + sign-out redirect URL) in the console.
#NEXT_PUBLIC_ASGARDEO_AFTER_SIGN_IN_URL=http://localhost:3000
#NEXT_PUBLIC_ASGARDEO_AFTER_SIGN_OUT_URL=http://localhost:3000

# Redirect URLs — must exactly match the URLs registered on the Asgardeo app.
NEXT_PUBLIC_ASGARDEO_AFTER_SIGN_IN_URL=http://localhost:3000
NEXT_PUBLIC_ASGARDEO_AFTER_SIGN_OUT_URL=http://localhost:3000

# ── WSO2 Identity Server (OIDC / OAuth 2.0, legacy hand-rolled flow) ───────
# OAuth2 token endpoint base of your WSO2 tenant, WITHOUT a trailing slash.
# WSO2 IS (on-prem): https://<host>/t/<tenant-domain>/oauth2
# Asgardeo:          https://api.asgardeo.io/t/<org-name>/oauth2
NEXT_PUBLIC_WSO2_AUTHORITY=https://identity.acmetech.com/t/acmetech.com/oauth2

# OAuth/OpenID Connect client key of this Single Page Application
# (create an SPA in the WSO2 Console; grant type: authorization_code + refresh_token)
NEXT_PUBLIC_WSO2_CLIENT_ID=your-wso2-spa-client-id

# Authorized Redirect URL — must EXACTLY match a value registered on the
# WSO2 application ("Authorized Redirect URLs" list), scheme + host + path.
NEXT_PUBLIC_REDIRECT_URI=http://localhost:3000/auth/callback

# Optional: space-separated scopes (defaults to "openid profile email")
#NEXT_PUBLIC_OIDC_SCOPES=openid profile email

# Optional: organization label shown as fallback when the ID token has no
# organization claim.
#NEXT_PUBLIC_ORGANIZATION_NAME=Acme Technologies Inc.

# ── Backend API ──────────────────────────────────────────────────────────
# Base URL used by the frontend data client (proxied via next.config rewrites).
#NEXT_PUBLIC_API_BASE=/api
INGESTION_API_URL=http://localhost:8003
