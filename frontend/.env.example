# Zellovest Frontend — Public Environment Configuration
# Copy to .env.local (development) or inject at build time (production).
# These values are safe to expose to the browser (NEXT_PUBLIC_*).

# ── Custom local auth (invite-only, no public signup) ───────────────────
# The backend (ingestion gateway via Next rewrites) serves:
#   POST /api/v1/auth/login | GET /api/v1/auth/me
#   POST /api/v1/auth/invites (member) | GET+POST /api/v1/auth/invites/validate|accept (public)
# Accounts are created by backend/scripts/seed_user.py (first/demo user)
# or by claiming an invite link (/invite/accept?token=…).

# Public demo account (documented sandbox login for the "Explore the live
# demo" button; seeded via `uv run python scripts/seed_user.py --demo`).
#NEXT_PUBLIC_DEMO_EMAIL=demo@zellovest.ai
#NEXT_PUBLIC_DEMO_PASSWORD=zellovest-demo

# Single-tenant organization display name (public branding).
#NEXT_PUBLIC_ORGANIZATION_NAME=Acme Technologies Inc.

# ── Backend API ──────────────────────────────────────────────────────────
# Base URL used by the frontend data client (proxied via next.config rewrites).
#NEXT_PUBLIC_API_BASE=/api
INGESTION_API_URL=http://localhost:8003
