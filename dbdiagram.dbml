// Zellovest — Postgres operational DB (V1 single-tenant, V2 DB-per-tenant ready)
// Paste into https://dbdiagram.io to render ER diagram.
// v2: redesigned to accommodate Ramp (bills/transactions/users/departments/merchants/vendors)
//     + Okta (apps/users/logs/groups) payloads given 2026-10-09.
// Rules: tenant_id TEXT on every table, UUID PKs, Ramp/Okta external IDs UNIQUE per tenant,
// contract versioning (never UPDATE), immutable intelligence outputs.
// Vectors / S3 bytes OUT of scope — only metadata lives here.

Project Zellovest {
  database_type: 'PostgreSQL'
  Note: 'Operational DB only. One database per customer (V2 DB-per-tenant). tenant_id = deployment ID in V1.'
}

Enum doc_type {
  contract
  amendment
  invoice
  purchase_order
  policy
  other
}

Enum doc_status {
  staged
  processing
  extracted
  review_needed
  failed
}

Enum contract_status {
  draft
  active
  expired
  terminated
  renewed
}

Enum po_status {
  draft
  sent
  partially_received
  received
  cancelled
}

Enum invoice_status {
  pending
  approved
  paid
  rejected
  flagged
}

Enum txn_source {
  ramp
  webhook
  manual
}

Enum exception_rule {
  price
  quantity
  date
  discount
  tax
  freight
  payment_term
  missing_po
}

Enum exception_status {
  open
  acknowledged
  resolved
  dismissed
}

Enum alert_status {
  open
  notified
  migrated
  dismissed
}

Enum workflow_type {
  invoice_approval
  contract_review
  vendor_onboarding
  purchase_order_approval
  renewal_negotiation
  human_review
}

Enum workflow_status {
  pending
  in_progress
  approved
  rejected
  cancelled
}

Enum savings_kind {
  hard_cash
  avoidance
}

Enum savings_status {
  potential
  verified
}

Enum risk_class {
  read_only
  low_risk
  high_risk
}

// ---------- A. Foundation ----------

Table tenants {
  tenant_id text [pk, not null, note: 'V1 = deployment ID. V2 = DB-per-tenant, one row per DB']
  name varchar(256) [not null]
  status varchar(32) [not null, default: 'active']
  kms_key_id text [note: 'V1 null (single global key). V2 per-tenant KMS']
  org_id uuid [note: 'V2 future use only, always NULL in V1']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

// Custom email/password auth (replaces WSO2). Matches 0004_users + models.User.
// V1: single role procurement_member for every row; only bcrypt PHC hash stored.
Table users {
  id uuid [pk, not null]
  tenant_id text [not null, default: 'default', note: 'V1 = default deployment ID']
  email varchar(320) [not null, note: 'login; GLOBALLY unique in V1 (uq_users_email)']
  name varchar(256) [not null, default: '']
  password_hash text [not null, note: 'bcrypt PHC string (salt+cost embedded), never plaintext']
  role varchar(64) [not null, default: 'procurement_member']
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    email [unique, name: 'uq_users_email']
    (tenant_id) [name: 'ix_users_tenant_id']
    (email) [name: 'ix_users_email']
  }
}

// Invite-only onboarding (public signup removed). Matches 0005_invitations + models.Invitation.
// Flow: member invites email -> 256-bit token generated, only SHA-256 hash stored ->
// invitee sets name+password -> users row created, invite marked accepted.
Table invitations {
  id uuid [pk, not null]
  tenant_id text [not null, default: 'default']
  email varchar(320) [not null, note: 'invitee address']
  token_hash varchar(64) [not null, note: 'SHA-256 of single-use token; token itself never stored']
  invited_by_user_id uuid [note: 'FK users.id (inviter), nullable']
  expires_at timestamptz [not null, note: 'invite window end']
  accepted_at timestamptz [note: 'NULL = pending']
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    token_hash [unique, name: 'uq_invitations_token_hash']
    (tenant_id) [name: 'ix_invitations_tenant_id']
    (email) [name: 'ix_invitations_email']
    (token_hash) [name: 'ix_invitations_token_hash']
  }
}

// Ramp departments.read -> first-class (was VARCHAR before)
Table departments {
  id uuid [pk, not null]
  tenant_id text [not null]
  ramp_department_id text [not null, note: 'Ramp departments.read id']
  name varchar(256) [not null]
  head_employee_id uuid [note: 'Ramp department_head_id -> employees, nullable (circular)']
  ramp_created_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (tenant_id, ramp_department_id) [unique]
    (tenant_id, name) [name: 'ix_dept_tenant_name']
  }
}

// Ramp location_id / entity_id have no object spec yet -> minimal dims, grow later
Table locations {
  id uuid [pk, not null]
  tenant_id text [not null]
  ramp_location_id text [not null, note: 'Ramp location_id, no object spec yet']
  name varchar(256)
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    (tenant_id, ramp_location_id) [unique]
  }
}

Table business_entities {
  id uuid [pk, not null]
  tenant_id text [not null]
  ramp_entity_id text [not null, note: 'Ramp entity_id on bills/txns/users']
  name varchar(256)
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    (tenant_id, ramp_entity_id) [unique]
  }
}

// Ramp merchants.read -> raw network entity (merchant != vendor)
Table merchants {
  id uuid [pk, not null]
  tenant_id text [not null]
  ramp_merchant_id text [not null, note: 'merchants.read id']
  name varchar(256) [not null]
  merchant_url varchar(512)
  icon_url text
  sk_category_id integer
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (tenant_id, ramp_merchant_id) [unique]
    (tenant_id, name) [name: 'ix_merch_tenant_name']
  }
}

Table vendors {
  id uuid [pk, not null]
  tenant_id text [not null]
  name varchar(256) [not null]
  domain varchar(256) [note: 'for merchant -> vendor resolution']
  category varchar(128)
  payment_terms text
  status varchar(32) [not null, default: 'active']
  // --- Ramp vendors.read ---
  ramp_vendor_id text [note: 'vendors.read id, UNIQUE per tenant']
  external_vendor_id varchar(128) [note: 'vendors.read external_vendor_id e.g. VEND-882']
  merchant_id uuid [note: 'vendors.read merchant_id -> merchants']
  owner_employee_id uuid [note: 'vendors.read vendor_owner_id -> employees']
  sk_category_id integer
  accounting_remote_ids jsonb [note: 'accounting_vendor_remote_ids[]']
  is_active boolean [not null, default: true]
  ramp_created_at timestamptz
  ramp_updated_at timestamptz
  metadata jsonb [note: 'flex fields, never core FKs']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (tenant_id, name) [unique]
    (tenant_id, ramp_vendor_id) [unique, name: 'uq_vendors_tenant_ramp']
    (tenant_id, category) [name: 'ix_vendors_tenant_cat']
  }
}

Table employees {
  id uuid [pk, not null]
  tenant_id text [not null]
  email varchar(256) [not null]
  display_name varchar(256)
  first_name varchar(128) [note: 'Ramp + Okta profile']
  last_name varchar(128)
  employee_code varchar(64) [note: 'Ramp employee_id e.g. EMP-1042']
  department_id uuid [note: 'FK departments (replaces free-text dept)']
  department_raw varchar(128) [note: 'fallback before resolution']
  location_id uuid [note: 'FK locations']
  business_entity_id uuid [note: 'FK business_entities (Ramp entity_id)']
  manager_id uuid [note: 'self-FK: Ramp manager_id']
  employment_status varchar(32) [default: 'active']
  ramp_user_id text [note: 'Ramp users.read id']
  ramp_role varchar(64) [note: 'Ramp role e.g. BUSINESS_USER']
  ramp_status varchar(64) [note: 'Ramp status e.g. USER_ACTIVE']
  okta_user_id text [note: 'Okta /users id']
  okta_status varchar(32)
  last_login_at timestamptz [note: 'Okta lastLogin']
  ramp_created_at timestamptz
  okta_created_at timestamptz
  okta_updated_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (tenant_id, email) [unique]
    (tenant_id, ramp_user_id) [unique, name: 'uq_emp_tenant_ramp']
    (tenant_id, okta_user_id) [unique, name: 'uq_emp_tenant_okta']
    (tenant_id, department_id) [name: 'ix_emp_tenant_dept']
    (tenant_id, employee_code) [name: 'ix_emp_tenant_code']
  }
}

// Physical cards (Ramp transactions.card_id)
Table ramp_cards {
  id uuid [pk, not null]
  tenant_id text [not null]
  ramp_card_id text [not null]
  employee_id uuid [note: 'holder -> employees']
  card_last4 char(4)
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    (tenant_id, ramp_card_id) [unique]
    (tenant_id, employee_id) [name: 'ix_cards_tenant_emp']
  }
}

Table software_catalog {
  id uuid [pk, not null]
  tenant_id text [not null]
  name varchar(256) [not null, note: 'approved tool, e.g. GitHub Copilot Enterprise']
  vendor_id uuid [note: 'FK vendors if contracted vendor known']
  okta_app_id uuid [note: 'FK okta_apps if provisioned via Okta']
  category varchar(128)
  capability_text text [note: 'source text for embedding; vector lives outside Postgres']
  website varchar(256)
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    (tenant_id, name) [unique]
  }
}

// ---------- B. Documents (metadata only) ----------

Table uploads {
  id uuid [pk, not null]
  tenant_id text [not null]
  vendor_id uuid
  filename varchar(255) [not null]
  gcs_key text [not null]
  mime_type varchar(128) [not null]
  size_expected bigint [not null]
  document_type varchar(32) [not null, default: 'other']
  status varchar(32) [not null, default: 'pending']
  error text
  expires_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    gcs_key [unique]
    (tenant_id, status) [name: 'ix_uploads_tenant_status']
  }
}

Table documents {
  id uuid [pk, not null]
  tenant_id text [not null]
  vendor_id uuid [note: 'resolved vendor, nullable until classified']
  upload_id uuid
  s3_key text [not null, note: 'MUST embed tenant: {tenant_id}/... (PRD 28.2)']
  filename varchar(255) [not null]
  document_type doc_type [not null]
  mime_type varchar(128) [not null]
  status doc_status [not null, default: 'staged']
  classifier_confidence numeric(5,4)
  page_count integer
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (tenant_id, vendor_id, document_type) [name: 'ix_docs_tenant_vendor_type']
    s3_key [unique]
  }
}

Table extraction_provenance {
  id uuid [pk, not null]
  tenant_id text [not null]
  document_id uuid [not null]
  entity_type varchar(32) [not null, note: 'contract | invoice | purchase_order']
  entity_id uuid [not null, note: 'polymorphic target row id; no DB FK by design']
  field_name varchar(128) [not null, note: 'e.g. renewal_date, unit_price']
  field_value_text text [not null]
  confidence numeric(5,4)
  page integer
  bbox_json jsonb [note: 'bounding box for PDF highlight']
  extraction_method varchar(64) [note: 'python | document_ai | llm | human']
  extracted_at timestamptz [not null, default: `now()`]

  Indexes {
    (tenant_id, document_id) [name: 'ix_prov_tenant_doc']
    (tenant_id, entity_type, entity_id) [name: 'ix_prov_tenant_entity']
  }
}

// ---------- C. Commercial truth (versioned, never overwrite) ----------

Table contracts {
  id uuid [pk, not null]
  tenant_id text [not null]
  vendor_id uuid [not null]
  document_id uuid [note: 'source contract PDF']
  contract_number varchar(128) [not null]
  title varchar(256)
  status contract_status [not null, default: 'active']
  start_date date [not null]
  end_date date
  renewal_date date [note: 'drives 120/90/60/30-day renewal scan']
  notice_period_days integer
  auto_renew boolean [not null, default: false]
  termination_clause text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (tenant_id, contract_number) [unique]
    (tenant_id, renewal_date) [name: 'ix_contracts_tenant_renewal']
    (tenant_id, vendor_id) [name: 'ix_contracts_tenant_vendor']
  }
}

Table contract_terms_versioned {
  id uuid [pk, not null]
  tenant_id text [not null]
  contract_id uuid [not null]
  version_no integer [not null]
  product_code varchar(128)
  description text
  unit_price numeric(14,2) [not null]
  currency char(3) [not null, default: 'USD']
  uom varchar(32) [note: 'per user / per seat / per GB']
  qty_min numeric(14,2)
  qty_max numeric(14,2)
  discount_pct numeric(7,4)
  tax_rule text
  payment_terms text
  freight_terms text
  escalation_pct numeric(7,4)
  effective_from date [not null]
  effective_to date [note: 'NULL = current version']
  amendment_document_id uuid [note: 'which amendment created this version']
  created_at timestamptz [not null, default: `now()`]

  Note: 'Postgres EXCLUDE (contract_id WITH =, daterange(effective_from,effective_to) WITH &&) prevents overlapping versions. Enforce in migration, not expressible in DBML.'

  Indexes {
    (tenant_id, contract_id, version_no) [unique]
    (tenant_id, contract_id, effective_from, effective_to) [name: 'ix_ctv_tenant_contract_dates']
  }
}

// ---------- D. Transact (Ramp bills + transactions) ----------

Table purchase_orders {
  id uuid [pk, not null]
  tenant_id text [not null]
  vendor_id uuid [not null]
  contract_id uuid
  source_document_id uuid
  po_number varchar(128) [not null]
  order_date timestamptz [not null]
  expected_date timestamptz
  currency char(3) [not null, default: 'USD']
  subtotal numeric(14,2) [not null]
  tax_amount numeric(14,2) [not null, default: 0]
  total_amount numeric(14,2) [not null]
  status po_status [not null, default: 'draft']
  metadata jsonb
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (tenant_id, po_number) [unique]
    (tenant_id, vendor_id) [name: 'ix_po_tenant_vendor']
  }
}

Table po_line_items {
  id uuid [pk, not null]
  tenant_id text [not null]
  po_id uuid [not null]
  line_no integer [not null]
  description text [not null]
  product_code varchar(128)
  quantity numeric(14,2) [not null]
  unit_price numeric(14,2) [not null]
  total numeric(14,2) [not null]

  Indexes {
    (po_id, line_no) [unique]
  }
}

// Ramp bills:read -> invoices. invoice_date = issued_at.
Table invoices {
  id uuid [pk, not null]
  tenant_id text [not null]
  vendor_id uuid [not null]
  contract_id uuid [note: 'resolved contract at ingest; version resolved at audit time']
  po_id uuid [note: 'Ramp purchase_order_id, null in sample']
  document_id uuid [note: 'source invoice PDF (Drive/manual); Ramp bills have invoice_url instead']
  business_entity_id uuid [note: 'Ramp entity_id']
  invoice_number varchar(128) [not null]
  invoice_date timestamptz [not null, note: 'Ramp issued_at']
  due_date timestamptz [note: 'Ramp due_at']
  paid_date timestamptz [note: 'Ramp paid_at']
  currency char(3) [not null, default: 'USD']
  subtotal numeric(14,2) [not null, note: 'Ramp has only total; subtotal=total-tax if needed']
  tax_amount numeric(14,2) [not null, default: 0]
  total_amount numeric(14,2) [not null, note: 'Ramp amount.amount']
  status invoice_status [not null, default: 'pending']
  // --- Ramp bill fields ---
  ramp_bill_id text [not null, note: 'bills.read id, idempotency key']
  invoice_url text [note: 'bills.read invoice_url']
  payment_method varchar(64) [note: 'e.g. ACH']
  payment_status varchar(64) [note: 'e.g. PAID']
  approval_status varchar(64) [note: 'e.g. APPROVED']
  status_summary varchar(128)
  sync_status varchar(64) [note: 'e.g. BILL_AND_PAYMENT_SYNCED']
  ramp_created_at timestamptz
  metadata jsonb
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (tenant_id, invoice_number) [unique]
    (tenant_id, ramp_bill_id) [unique, name: 'uq_inv_tenant_ramp']
    (tenant_id, vendor_id, invoice_date) [name: 'ix_inv_tenant_vendor_date']
  }
}

// Ramp bill lines carry amount only (no qty/unit) -> quantity_derived flag
Table invoice_line_items {
  id uuid [pk, not null]
  tenant_id text [not null]
  invoice_id uuid [not null]
  line_no integer [not null]
  description text [not null]
  product_code varchar(128)
  quantity numeric(14,2) [not null, note: 'Ramp: 1 + derived=true']
  unit_price numeric(14,2) [not null, note: 'Ramp: = amount']
  total numeric(14,2) [not null]
  ramp_line_id text [note: 'bill line id']
  category_id integer [note: 'Ramp category_id e.g. 40']
  accounting_selections jsonb [note: 'Ramp accounting_field_selections[]']
  quantity_derived boolean [not null, default: false]

  Indexes {
    (invoice_id, line_no) [unique]
    (tenant_id, ramp_line_id) [name: 'ix_invl_tenant_ramp']
  }
}

// Ramp transactions:read -> card_transactions. txn_date = user_transaction_time.
Table card_transactions {
  id uuid [pk, not null]
  tenant_id text [not null]
  employee_id uuid [note: 'resolved via Ramp user_id -> employees.ramp_user_id']
  vendor_id uuid [note: 'resolved vendor; null = unmanaged/unknown']
  merchant_id uuid [note: 'FK merchants (raw network entity)']
  card_id uuid [note: 'FK ramp_cards']
  department_id uuid [note: 'FK departments']
  location_id uuid [note: 'FK locations']
  business_entity_id uuid [note: 'FK business_entities (Ramp entity_id)']
  merchant_name text [not null, note: 'denormalized for fast maverick scan']
  merchant_domain varchar(256)
  amount numeric(14,2) [not null]
  currency char(3) [not null, default: 'USD']
  txn_date timestamptz [not null, note: 'Ramp user_transaction_time']
  cleared_at timestamptz
  state varchar(32) [note: 'Ramp state e.g. CLEARED']
  sk_category_id integer
  sk_category_name varchar(128) [note: 'e.g. SaaS / Software; maps to mcc heuristic']
  mcc varchar(8) [note: 'kept for non-Ramp sources']
  card_last4 char(4)
  cardholder_name_raw text [note: 'pre-resolution Ramp string']
  memo text [note: 'Ramp memo e.g. Monthly AI API subscription']
  receipts jsonb [note: 'Ramp receipts[{id, receipt_url}]']
  accounting_selections jsonb
  has_been_approved boolean
  requirements_met boolean [note: 'all_requirements_met_and_approved']
  sync_status varchar(64)
  is_recurring boolean [not null, default: false]
  recurrence_interval_days integer
  source txn_source [not null, default: 'ramp']
  external_id text [not null, note: 'Ramp transaction id; idempotency key']
  raw_s3_key text [note: 'bronze JSONL location']
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    (tenant_id, external_id) [unique]
    (tenant_id, txn_date) [name: 'ix_txn_tenant_date']
    (tenant_id, merchant_id) [name: 'ix_txn_tenant_merchid']
    (tenant_id, merchant_name) [name: 'ix_txn_tenant_merch']
    (tenant_id, employee_id) [name: 'ix_txn_tenant_emp']
    (tenant_id, department_id) [name: 'ix_txn_tenant_dept']
  }
}

// ---------- E. Identity / Usage (Okta) ----------

Table okta_apps {
  id uuid [pk, not null]
  tenant_id text [not null]
  okta_app_id text [not null, note: 'Okta apps.read id e.g. 0oa...']
  name varchar(256) [not null, note: 'e.g. testorgone_customsaml20app_1']
  label varchar(256) [note: 'display label e.g. Custom Saml 2.0 App']
  status varchar(32) [note: 'ACTIVE etc.']
  sign_on_mode varchar(64)
  okta_created_at timestamptz
  okta_updated_at timestamptz
  raw_json jsonb [note: 'full Okta payload (accessibility/visibility/credentials) if audit needs it']
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    (tenant_id, okta_app_id) [unique]
    (tenant_id, label) [name: 'ix_oktaapps_tenant_label']
  }
}

Table okta_groups {
  id uuid [pk, not null]
  tenant_id text [not null]
  okta_group_id text [not null]
  name varchar(256) [not null, note: 'e.g. West Coast users (NOT the same as departments)']
  description text
  group_type varchar(64) [note: 'OKTA_GROUP | APP_GROUP']
  okta_created_at timestamptz
  okta_updated_at timestamptz
  last_membership_updated timestamptz
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    (tenant_id, okta_group_id) [unique]
    (tenant_id, name) [name: 'ix_oktagroups_tenant_name']
  }
}

Table okta_group_memberships {
  id uuid [pk, not null]
  tenant_id text [not null]
  group_id uuid [not null]
  employee_id uuid [not null]
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    (group_id, employee_id) [unique]
    (tenant_id, employee_id) [name: 'ix_oktagm_tenant_emp']
  }
}

Table license_assignments {
  id uuid [pk, not null]
  tenant_id text [not null]
  employee_id uuid [not null]
  vendor_id uuid [not null, note: 'SaaS vendor, e.g. Salesforce']
  okta_app_id uuid [note: 'FK okta_apps when provisioned via Okta']
  app_id_text text [note: 'raw Okta app id before resolution']
  seats integer [not null, default: 1]
  assigned_at timestamptz [not null, default: `now()`]
  unassigned_at timestamptz
  status varchar(32) [not null, default: 'active']
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    (tenant_id, employee_id, vendor_id) [name: 'ix_lic_tenant_emp_vendor']
    (tenant_id, vendor_id, status) [name: 'ix_lic_tenant_vendor_status']
  }
}

// Okta logs.read -> usage_events. occurred_at = published, id = uuid.
Table usage_events {
  id uuid [pk, not null]
  tenant_id text [not null]
  employee_id uuid [note: 'resolved via actor.alternateId (email)']
  vendor_id uuid [note: 'resolved app vendor']
  okta_app_id uuid [note: 'FK okta_apps via target AppInstance']
  app_id_text text [note: 'raw Okta app/target id']
  event_type varchar(128) [not null, note: 'Okta eventType e.g. user.session.start']
  display_message text
  outcome_result varchar(32) [note: 'outcome.result SUCCESS/FAILURE']
  occurred_at timestamptz [not null, note: 'Okta published']
  okta_event_id text [not null, note: 'Okta uuid, idempotency: {tenant}:{uuid}']
  target_json jsonb [note: 'Okta target[] (AuthenticatorEnrollment, AppInstance...)']
  raw_signal jsonb [note: 'full log incl. client/device/securityContext']
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    (tenant_id, okta_event_id) [unique]
    (tenant_id, employee_id, occurred_at) [name: 'ix_use_tenant_emp_time']
    (tenant_id, vendor_id, occurred_at) [name: 'ix_use_tenant_vendor_time']
    (tenant_id, okta_app_id, occurred_at) [name: 'ix_use_tenant_app_time']
  }
}

// ---------- F. Intelligence outputs (INSERT-only) ----------

Table reconciliation_exceptions {
  id uuid [pk, not null]
  tenant_id text [not null]
  invoice_id uuid [not null]
  invoice_line_id uuid
  contract_id uuid [not null]
  contract_version_id uuid [not null, note: 'applicable version at invoice_date']
  po_id uuid
  rule_type exception_rule [not null]
  expected_value numeric(14,2)
  billed_value numeric(14,2)
  variance_amount numeric(14,2)
  variance_pct numeric(9,4)
  severity varchar(16) [default: 'medium']
  status exception_status [not null, default: 'open']
  detected_at timestamptz [not null, default: `now()`]
  resolved_at timestamptz

  Indexes {
    (tenant_id, status) [name: 'ix_rec_tenant_status']
    (tenant_id, invoice_id) [name: 'ix_rec_tenant_invoice']
  }
}

Table maverick_alerts {
  id uuid [pk, not null]
  tenant_id text [not null]
  transaction_id uuid [not null]
  employee_id uuid
  merchant_name text [not null]
  jev_is_saas_score numeric(5,4) [note: 'Jev p(is_unmanaged_saas) 0-1']
  jev_review_score numeric(5,4) [note: 'Jev p(warrants_review) 0-1']
  status alert_status [not null, default: 'open']
  capability_text text [note: 'Stage-2 resolved description']
  overlap_catalog_id uuid [note: 'FK software_catalog: approved alternative']
  overlap_score numeric(5,4) [note: 'cosine similarity, e.g. 0.91']
  recommended_action text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (tenant_id, status) [name: 'ix_mav_tenant_status']
    (tenant_id, employee_id) [name: 'ix_mav_tenant_emp']
  }
}

Table seat_forecasts {
  id uuid [pk, not null]
  tenant_id text [not null]
  vendor_id uuid [not null]
  department_id uuid [note: 'FK departments (replaces free-text dept)']
  department varchar(128) [note: 'denormalized for fast reads; keep in sync']
  forecast_date date [not null]
  current_seats integer [not null]
  recommended_seats integer [not null]
  retention_curve jsonb [note: 'per-dept survival probabilities + CI']
  confidence numeric(5,4)
  shelfware_amount numeric(14,2)
  trueup_risk_amount numeric(14,2)
  savings_estimate numeric(14,2)
  model_version varchar(64)
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    (tenant_id, vendor_id, department, forecast_date) [unique]
  }
}

// ---------- G. Action close-loop ----------

Table workflows {
  id uuid [pk, not null]
  tenant_id text [not null]
  workflow_type workflow_type [not null]
  title varchar(256) [not null]
  description text
  reference_type varchar(32) [note: 'invoice | contract | maverick_alert | renewal; polymorphic, no FK']
  reference_id uuid [note: 'polymorphic target id']
  assignee_user_id uuid
  status workflow_status [not null, default: 'pending']
  current_step integer [not null, default: 1]
  total_steps integer [not null, default: 3]
  due_at timestamptz
  completed_at timestamptz
  metadata jsonb
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (tenant_id, status) [name: 'ix_wf_tenant_status']
    (tenant_id, assignee_user_id) [name: 'ix_wf_tenant_assignee']
    (tenant_id, reference_type, reference_id) [name: 'ix_wf_tenant_ref']
  }
}

Table savings_ledger {
  id uuid [pk, not null]
  tenant_id text [not null]
  vendor_id uuid
  source_type varchar(32) [not null, note: 'overbill | seats_cut | maverick']
  source_id uuid [not null, note: 'polymorphic: exception/alert/forecast id']
  amount numeric(14,2) [not null]
  currency char(3) [not null, default: 'USD']
  kind savings_kind [not null, note: 'hard_cash vs avoidance']
  status savings_status [not null, default: 'potential']
  verified_by_user_id uuid
  verified_at timestamptz
  notes text
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    (tenant_id, kind, status) [name: 'ix_sav_tenant_kind_status']
    (tenant_id, vendor_id) [name: 'ix_sav_tenant_vendor']
  }
}

Table audit_events {
  id uuid [pk, not null]
  tenant_id text [not null]
  actor_user_id uuid
  correlation_id text [not null]
  mcp_server varchar(64) [note: 'procurement | document | external']
  tool_name varchar(128) [not null]
  tool_version varchar(32)
  risk_class risk_class [not null, default: 'read_only']
  auth_result varchar(32) [not null, default: 'allowed']
  success boolean [not null, default: true]
  error_class varchar(128)
  latency_ms integer
  result_size integer
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    (tenant_id, created_at) [name: 'ix_audit_tenant_time']
    (tenant_id, correlation_id) [name: 'ix_audit_tenant_corr']
  }
}

// ---------- H. Existing ingestion infra (already in Alembic, shown for completeness) ----------

Table tenant_integrations {
  id uuid [pk, not null]
  tenant_id text [not null]
  provider varchar(64) [not null, default: 'ramp']
  encrypted_access_token bytea [not null]
  encrypted_refresh_token bytea [not null]
  access_nonce bytea [not null, note: 'GCM nonce for access token (renamed from encryption_nonce in 0009)']
  refresh_nonce bytea [note: 'GCM nonce for REFRESH token (0009); NULL = pre-0009 row, reconnect to fill']
  token_expires_at timestamptz
  connection_status varchar(32) [not null, default: 'ACTIVE']
  scopes jsonb
  last_error text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (tenant_id, provider) [unique]
  }
}

Table ingestion_sync_checkpoints {
  id uuid [pk, not null]
  sync_id uuid [not null]
  tenant_id text [not null]
  entity_type varchar(64) [not null, note: 'add: ramp_users/depts/merchants/vendors, okta_apps/groups']
  mode varchar(32) [not null, default: 'incremental']
  status varchar(32) [not null, default: 'PENDING']
  cursor_token text
  last_success_cursor text
  event_id varchar(256) [note: 'V2 scope as {tenant}:{event}; unique today is global']
  date_from varchar(32)
  date_to varchar(32)
  error_log text
  attempt_count bigint [not null, default: 0]
  started_at timestamptz
  finished_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    sync_id [unique]
    event_id [unique]
    (tenant_id, entity_type, status) [name: 'ix_checkpoints_tenant_entity_status']
  }
}

// ---------- Relationships ----------

Ref: users.tenant_id > tenants.tenant_id
Ref: invitations.tenant_id > tenants.tenant_id
Ref: invitations.invited_by_user_id > users.id
Ref: departments.tenant_id > tenants.tenant_id
Ref: locations.tenant_id > tenants.tenant_id
Ref: business_entities.tenant_id > tenants.tenant_id
Ref: merchants.tenant_id > tenants.tenant_id
Ref: vendors.tenant_id > tenants.tenant_id
Ref: employees.tenant_id > tenants.tenant_id
Ref: ramp_cards.tenant_id > tenants.tenant_id
Ref: software_catalog.tenant_id > tenants.tenant_id
Ref: okta_apps.tenant_id > tenants.tenant_id
Ref: documents.tenant_id > tenants.tenant_id
Ref: contracts.tenant_id > tenants.tenant_id
Ref: contract_terms_versioned.tenant_id > tenants.tenant_id
Ref: purchase_orders.tenant_id > tenants.tenant_id
Ref: invoices.tenant_id > tenants.tenant_id
Ref: card_transactions.tenant_id > tenants.tenant_id

Ref: employees.department_id > departments.id
Ref: employees.location_id > locations.id
Ref: employees.business_entity_id > business_entities.id
Ref: employees.manager_id > employees.id
Ref: departments.head_employee_id > employees.id
Ref: vendors.merchant_id > merchants.id
Ref: vendors.owner_employee_id > employees.id
Ref: ramp_cards.employee_id > employees.id
Ref: software_catalog.vendor_id > vendors.id
Ref: software_catalog.okta_app_id > okta_apps.id
Ref: documents.vendor_id > vendors.id
Ref: documents.upload_id > uploads.id
Ref: extraction_provenance.document_id > documents.id
Ref: contracts.vendor_id > vendors.id
Ref: contracts.document_id > documents.id
Ref: contract_terms_versioned.contract_id > contracts.id
Ref: contract_terms_versioned.amendment_document_id > documents.id
Ref: purchase_orders.vendor_id > vendors.id
Ref: purchase_orders.contract_id > contracts.id
Ref: purchase_orders.source_document_id > documents.id
Ref: po_line_items.po_id > purchase_orders.id
Ref: invoices.vendor_id > vendors.id
Ref: invoices.contract_id > contracts.id
Ref: invoices.po_id > purchase_orders.id
Ref: invoices.document_id > documents.id
Ref: invoices.business_entity_id > business_entities.id
Ref: invoice_line_items.invoice_id > invoices.id
Ref: card_transactions.employee_id > employees.id
Ref: card_transactions.vendor_id > vendors.id
Ref: card_transactions.merchant_id > merchants.id
Ref: card_transactions.card_id > ramp_cards.id
Ref: card_transactions.department_id > departments.id
Ref: card_transactions.location_id > locations.id
Ref: card_transactions.business_entity_id > business_entities.id
Ref: okta_group_memberships.group_id > okta_groups.id
Ref: okta_group_memberships.employee_id > employees.id
Ref: license_assignments.employee_id > employees.id
Ref: license_assignments.vendor_id > vendors.id
Ref: license_assignments.okta_app_id > okta_apps.id
Ref: usage_events.employee_id > employees.id
Ref: usage_events.vendor_id > vendors.id
Ref: usage_events.okta_app_id > okta_apps.id
Ref: reconciliation_exceptions.invoice_id > invoices.id
Ref: reconciliation_exceptions.invoice_line_id > invoice_line_items.id
Ref: reconciliation_exceptions.contract_id > contracts.id
Ref: reconciliation_exceptions.contract_version_id > contract_terms_versioned.id
Ref: reconciliation_exceptions.po_id > purchase_orders.id
Ref: maverick_alerts.transaction_id > card_transactions.id
Ref: maverick_alerts.employee_id > employees.id
Ref: maverick_alerts.overlap_catalog_id > software_catalog.id
Ref: seat_forecasts.vendor_id > vendors.id
Ref: seat_forecasts.department_id > departments.id
Ref: workflows.assignee_user_id > users.id
Ref: savings_ledger.vendor_id > vendors.id
Ref: savings_ledger.verified_by_user_id > users.id
Ref: audit_events.actor_user_id > users.id
